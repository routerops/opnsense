{
  "extends": ["config:recommended"],
  "pip_requirements": {
    "fileMatch": ["requirements-dev\\.txt$", "requirements-oldest\\.txt$"]
  },
  "packageRules": [
    {
      "matchFileNames": ["requirements-oldest.txt"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ]
}
